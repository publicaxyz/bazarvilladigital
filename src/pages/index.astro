    </section>

    <!-- CTA final  el contador chismoso es el final badge-->
    <section class="cta-final reveal" id="cta-final">
      <div class="cta-final-glow" aria-hidden="true"></div>
      <div class="cta-final-grid" aria-hidden="true"></div>

<div class="cta-final-badge" id="siteVisitsCounter">
    <span class="cta-dot"></span> Cargando visitas...
</div>

