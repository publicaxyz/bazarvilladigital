      {SOCIAL_LINKS.map((link) => (
        <a href={link.url} target="_blank" rel="noopener" class="social-link">
          {link.name}
        </a>
      ))}
    </div>

    <p class="footer-copy">© {new Date().getFullYear()} <a href={CREDIT_URL} target="_blank" rel="noopener">{SITE_LOGO}{SITE_LOGO_ACCENT}</a> · Todos los derechos reservados.</p>
    <p class="footer-designer"><a href={CREDIT_URL} target="_blank" rel="noopener">{CREDIT_TEXT} {CREDIT_NAME}</a></p>
  </footer>


</Layout>

<script define:vars={{ rotatorLines, WA_NUMBER, showCurrencyToggle, currencyClientConfig, initialCurrency, allowUsdToggle: ALLOW_USD_TOGGLE, fixedVesRateEnabled: FIXED_VES_RATE_ENABLED, fixedVesRate: FIXED_VES_RATE }}>
  document.querySelectorAll(".faq-q").forEach((btn) => {
    btn.addEventListener("click", () => {
      const item = btn.closest(".faq-item");
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      document.querySelectorAll(".faq-item").forEach((el) => {
        el.querySelector(".faq-q").setAttribute("aria-expanded", "false");
        el.classList.remove("open");
      });
      if (!isOpen) {
        btn.setAttribute("aria-expanded", "true");
        item.classList.add("open");
      }
    });
  });





// ——— SCRIPT CORREGIDO Y BLINDADO ———

// 1. Incrementar y cargar contador de visitas global (Tabla: site_visits)
async function initSiteVisits() {
    const counterEls = document.querySelectorAll("#siteVisitsCounter, .site-visits-counter");
    if (counterEls.length === 0) return;

    try {
        // Registra la visita y obtiene el total directamente del POST
        let res = await fetch('/api/visits', { method: 'POST' });
        let data = await res.json();
        
        const visitsTotal = data.total_visits !== undefined ? data.total_visits : (data.count !== undefined ? data.count : 2430);
        
        counterEls.forEach(el => {
            el.innerHTML = `<span class="cta-dot"></span> +${visitsTotal.toLocaleString()} visitas totales`;
        });
    } catch (e) {
        console.error("Error al cargar visitas:", e);
        counterEls.forEach(el => {
            el.innerHTML = `<span class="cta-dot"></span> +2,430 visitas totales`; // Valor por defecto seguro para que no se quede vacío
        });
    }
}

// 2. Manejar Likes por producto (Tabla: product_likes)
async function initProductLikes() {
    // Buscamos cualquier elemento en la página que tenga el identificador de producto
    const cards = document.querySelectorAll("[data-plan-id]");
    
    cards.forEach(async (card) => {
        const planId = card.getAttribute("data-plan-id");
        const countSpan = card.querySelector('.like-count');
        if (!planId || !countSpan) return;

        try {
            let res = await fetch(`/api/likes?product_id=${encodeURIComponent(planId)}`);
            let data = await res.json();
            
            const totalLikes = data.likes !== undefined ? data.likes : (data.likes_count !== undefined ? data.likes_count : 0);
            countSpan.textContent = totalLikes;
        } catch(e) {
            console.error("Error al cargar likes del producto:", planId);
        }
    });
}

// 3. Función segura para dar like
window.darLikeLocal = async function(btn) {
    if (btn.dataset.processing === "true") return;
    btn.dataset.processing = "true";

    // Buscamos el contenedor que tenga el ID del plan de forma directa
    const card = btn.closest('[data-plan-id]');
    if (!card) {
        btn.dataset.processing = "false";
        return;
    }
    
    const planId = card.getAttribute('data-plan-id');
    const countSpan = card.querySelector('.like-count');
    if (!planId || !countSpan) {
        btn.dataset.processing = "false";
        return;
    }

    // Animación visual de latido
    btn.classList.add('liked');
    setTimeout(() => btn.classList.remove('liked'), 300);

    try {
        const response = await fetch('/api/likes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ product_id: planId })
        });
        
        const data = await response.json();
        const confirmedLikes = data.likes !== undefined ? data.likes : (data.likes_count !== undefined ? data.likes_count : null);
        
        if (response.ok && confirmedLikes !== null) {
            countSpan.textContent = confirmedLikes; 
        }
    } catch (error) {
        console.error('Error al registrar el like en la BD:', error);
    } finally {
        btn.dataset.processing = "false";
    }
};
// Inicializar funciones al cargar la página
document.addEventListener("DOMContentLoaded", () => {
    initSiteVisits();
    initProductLikes();
});












  const rotatorEl = document.getElementById("ctaRotator");
  if (rotatorEl) {
    let idx = 0;
    setInterval(() => {
      rotatorEl.style.opacity = "0";
      setTimeout(() => {
        idx = (idx + 1) % rotatorLines.length;
        rotatorEl.textContent = rotatorLines[idx];
        rotatorEl.style.opacity = "1";
      }, 300);
    }, 3600);
  }

  const revealObserver = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) {
        e.target.classList.add("in-view");
        revealObserver.unobserve(e.target);
      }
    }),
    { threshold: 0.12 }
  );
  document.querySelectorAll(".reveal").forEach((el) => revealObserver.observe(el));

  document.querySelectorAll(".btn-magnetic").forEach((btn) => {
    btn.addEventListener("mousemove", (e) => {
      const rect = btn.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      btn.style.transform = `translate(${x * 0.18}px, ${y * 0.28}px)`;
    });
    btn.addEventListener("mouseleave", () => {
      btn.style.transform = "translate(0,0)";
    });
  });

  // ── Multimoneda ──
  const CURRENCY_FORMATTERS = {
    VES: (amount) => `Bs ${amount.toLocaleString("es-VE", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`,
    COP: (amount) => `$${amount.toLocaleString("es-CO", { minimumFractionDigits: 0, maximumFractionDigits: 0 })} COP`,
  };

  const CURRENCY_KEY = "lpc_currency";
  const RATE_CACHE_MS = 5 * 60 * 1000;

  function rateCacheKey(code) {
    return `lpc_rate_${code}`;
  }

  function loadStoredCurrency() {
    if (!showCurrencyToggle) return initialCurrency;
    const validCodes = currencyClientConfig.map((c) => c.code).concat(allowUsdToggle ? ["USD"] : []);
    try {
      const raw = localStorage.getItem(CURRENCY_KEY);
      return validCodes.includes(raw) ? raw : initialCurrency;
    } catch {
      return initialCurrency;
    }
  }

  function saveStoredCurrency(value) {
    try {
      localStorage.setItem(CURRENCY_KEY, value);
    } catch {}
  }

  function loadCachedRate(code) {
    try {
      const raw = localStorage.getItem(rateCacheKey(code));
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (typeof parsed.rate !== "number" || typeof parsed.fetchedAt !== "number") return null;
      return parsed;
    } catch {
      return null;
    }
  }

  function saveCachedRate(code, rate) {
    try {
      localStorage.setItem(rateCacheKey(code), JSON.stringify({ rate, fetchedAt: Date.now() }));
    } catch {}
  }

  let currency = loadStoredCurrency();
  const rates = {};

  function parseRate(code, json) {
    if (code === "VES") {
      const rate = json?.data?.binance?.buy_rate;
      return typeof rate === "number" && Number.isFinite(rate) && rate > 0 ? rate : null;
    }
    if (code === "COP") {
      const rate = json?.valor;
      return typeof rate === "number" && Number.isFinite(rate) && rate > 0 ? rate : null;
    }
    return null;
  }

  async function fetchRate(currencyConfig) {
    const { code, apiUrl } = currencyConfig;
    if (code === "VES" && fixedVesRateEnabled) {
      rates[code] = fixedVesRate;
      return rates[code];
    }
    const cached = loadCachedRate(code);
    if (cached && Date.now() - cached.fetchedAt < RATE_CACHE_MS) {
      rates[code] = cached.rate;
      return rates[code];
    }
    try {
      const res = await fetch(apiUrl);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      const rate = parseRate(code, json);
      if (rate == null) throw new Error("Tasa inválida");
      rates[code] = rate;
      saveCachedRate(code, rate);
      return rates[code];
    } catch {
      rates[code] = cached ? cached.rate : null;
      return rates[code];
    }
  }

  function fetchAllRates() {
    return Promise.all(currencyClientConfig.map(fetchRate));
  }

  function formatMoney(usdAmount) {
    if (currency !== "USD" && CURRENCY_FORMATTERS[currency]) {
      const rate = rates[currency];
      if (rate != null) return CURRENCY_FORMATTERS[currency](usdAmount * rate);
      return `Bs ${usdAmount.toFixed(2)}`;
    }
    return `Bs ${usdAmount.toFixed(2)}`;
  }

  const currencyToggle = document.getElementById("currencyToggle");

  function updateCurrencyToggleUI() {
    if (!currencyToggle) return;
    currencyToggle.querySelectorAll("[data-currency-btn]").forEach((btn) => {
      const isActive = btn.getAttribute("data-currency-btn") === currency;
      btn.classList.toggle("is-active", isActive);
      btn.setAttribute("aria-pressed", String(isActive));
    });
  }

  function renderAllPrices() {
    document.querySelectorAll(".cat-price-num[data-price-usd]").forEach((el) => {
      const usd = Number.parseFloat(el.getAttribute("data-price-usd"));
      el.textContent = formatMoney(usd);
    });
    updateCurrencyToggleUI();
    renderCart();
  }

  async function setCurrency(next) {
    currency = next;
    saveStoredCurrency(currency);
    if (next !== "USD" && rates[next] == null) {
      const conf = currencyClientConfig.find((c) => c.code === next);
      if (conf) await fetchRate(conf);
    }
    renderAllPrices();
  }

  if (showCurrencyToggle) {
    currencyToggle?.querySelectorAll("[data-currency-btn]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const next = btn.getAttribute("data-currency-btn");
        if (next && next !== currency) setCurrency(next);
      });
    });
  }

  const CART_KEY = "lpc_cart";

  function loadCart() {
    try {
      const raw = localStorage.getItem(CART_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }

  function saveCart(cart) {
    try {
      localStorage.setItem(CART_KEY, JSON.stringify(cart));
    } catch {}
  }

  let cart = loadCart();

  const cartFab = document.getElementById("cartFab");
  const cartFabCount = document.getElementById("cartFabCount");
  const cartOverlay = document.getElementById("cartOverlay");
  const cartDrawer = document.getElementById("cartDrawer");
  const cartClose = document.getElementById("cartClose");
  const cartItemsEl = document.getElementById("cartItems");
  const cartEmptyEl = document.getElementById("cartEmpty");
  const cartTotalEl = document.getElementById("cartTotal");
  const cartWaBtn = document.getElementById("cartWaBtn");

  function waCartUrl(items) {
    const lista = items.map((it) => `• ${it.name} x${it.quantity} — ${formatMoney(Number.parseFloat(it.price) * it.quantity)}/mes`).join("\n");
    const total = items.reduce((sum, it) => sum + Number.parseFloat(it.price) * it.quantity, 0);
    const plural = items.length > 1 || items.some((it) => it.quantity > 1) ? "estas cuentas" : "esta cuenta";
    const message = `Hola! Vengo de su página web y quiero activar ${plural}:\n\n${lista}\n\nTotal: ${formatMoney(total)}/mes\n\n¿Cómo procedo?`;
    return `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(message)}`;
  }

  function totalUnits() {
    return cart.reduce((sum, it) => sum + it.quantity, 0);
  }

  function syncCardButtons() {
    document.querySelectorAll(".cat-card[data-plan-id]").forEach((card) => {
      const id = card.getAttribute("data-plan-id");
      const addBtn = card.querySelector("[data-add-to-cart]");
      const stepper = card.querySelector("[data-stepper]");
      if (!addBtn || !stepper) return;
      const item = cart.find((it) => it.id === id);

      if (item) {
        addBtn.hidden = true;
        stepper.hidden = false;
        stepper.querySelector("[data-qty]").textContent = String(item.quantity);
      } else {
        addBtn.hidden = false;
        stepper.hidden = true;
      }
    });
  }

  function renderCart() {
    const units = totalUnits();
    cartFabCount.textContent = String(units);
    cartFab.hidden = units === 0;

    if (cart.length === 0) {
      cartItemsEl.innerHTML = "";
      cartEmptyEl.hidden = false;
      cartTotalEl.textContent = `${formatMoney(0)} / mes`;
      cartWaBtn.setAttribute("aria-disabled", "true");
      cartWaBtn.href = "#";
      return;
    }

    cartEmptyEl.hidden = true;
    cartItemsEl.innerHTML = cart
      .map(
        (it) => `
        <div class="cart-item" data-id="${it.id}">
          <div class="cart-item-info">
            <strong>${it.name}</strong>
            <span>${formatMoney(Number.parseFloat(it.price) * it.quantity)} / mes</span>
          </div>
          <div class="cart-item-actions">
            <div class="cat-stepper cat-stepper-sm">
              <button type="button" class="cat-stepper-btn" data-cart-qty-decrease="${it.id}" aria-label="Quitar una unidad de ${it.name}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
              <span class="cat-stepper-qty">${it.quantity}</span>
              <button type="button" class="cat-stepper-btn" data-cart-qty-increase="${it.id}" aria-label="Agregar una unidad de ${it.name}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              </button>
            </div>
            <button type="button" class="cart-item-remove" data-remove="${it.id}" aria-label="Quitar ${it.name} del carrito">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>`
      )
      .join("");

    const total = cart.reduce((sum, it) => sum + Number.parseFloat(it.price) * it.quantity, 0);
    cartTotalEl.textContent = `${formatMoney(total)} / mes`;
    cartWaBtn.removeAttribute("aria-disabled");
    cartWaBtn.href = waCartUrl(cart);

    cartItemsEl.querySelectorAll("[data-remove]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-remove");
        cart = cart.filter((it) => it.id !== id);
        saveCart(cart);
        renderCart();
        syncCardButtons();
      });
    });

    cartItemsEl.querySelectorAll("[data-cart-qty-increase]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-cart-qty-increase");
        const item = cart.find((it) => it.id === id);
        if (item) item.quantity += 1;
        saveCart(cart);
        renderCart();
        syncCardButtons();
      });
    });

    cartItemsEl.querySelectorAll("[data-cart-qty-decrease]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.getAttribute("data-cart-qty-decrease");
        const item = cart.find((it) => it.id === id);
        if (!item) return;
        if (item.quantity <= 1) {
          cart = cart.filter((it) => it.id !== id);
        } else {
          item.quantity -= 1;
        }
        saveCart(cart);
        renderCart();
        syncCardButtons();
      });
    });
  }

  function openCart() {
    cartDrawer.classList.add("open");
    cartOverlay.hidden = false;
    cartDrawer.setAttribute("aria-hidden", "false");
    requestAnimationFrame(() => cartOverlay.classList.add("visible"));
  }

  function closeCart() {
    cartDrawer.classList.remove("open");
    cartOverlay.classList.remove("visible");
    cartDrawer.setAttribute("aria-hidden", "true");
    setTimeout(() => { cartOverlay.hidden = true; }, 260);
  }

  cartFab.addEventListener("click", openCart);
  cartClose.addEventListener("click", closeCart);
  cartOverlay.addEventListener("click", closeCart);

  cartWaBtn.addEventListener("click", (e) => {
    if (cartWaBtn.getAttribute("aria-disabled") === "true") return;
    e.preventDefault();
    window.open(cartWaBtn.href, "_blank", "noopener");
    cart = [];
    saveCart(cart);
    renderCart();
    syncCardButtons();
    closeCart();
  });

  document.querySelectorAll(".cat-card[data-plan-id]").forEach((card) => {
    const id = card.getAttribute("data-plan-id");
    const name = card.getAttribute("data-plan-name");
    const price = card.getAttribute("data-plan-price");

    card.querySelector("[data-add-to-cart]")?.addEventListener("click", () => {
      cart.push({ id, name, price, quantity: 1 });
      saveCart(cart);
      renderCart();
      syncCardButtons();
    });

    card.querySelector("[data-qty-increase]")?.addEventListener("click", () => {
      const item = cart.find((it) => it.id === id);
      if (item) item.quantity += 1;
      saveCart(cart);
      renderCart();
      syncCardButtons();
    });

    card.querySelector("[data-qty-decrease]")?.addEventListener("click", () => {
      const item = cart.find((it) => it.id === id);
      if (!item) return;
      if (item.quantity <= 1) {
        cart = cart.filter((it) => it.id !== id);
      } else {
        item.quantity -= 1;
      }
      saveCart(cart);
      renderCart();
      syncCardButtons();
    });
  });

  // ── Mini función para el botón Me Gusta FUE ELIMINADA ESQUE ESTABA DUPLICADA──
 

  renderCart();
  syncCardButtons();

  renderAllPrices();
  if (currencyClientConfig.length > 0) {
    fetchAllRates().then(() => {
      if (currency !== "USD") renderAllPrices();
      else updateCurrencyToggleUI();
    });
  }
</script>

<style>
  :root {
    --hero-accent: var(--accent);
  }

  .page { position: relative; overflow-x: clip; }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(.2,.8,.2,1), transform 0.7s cubic-bezier(.2,.8,.2,1);
  }
  .reveal.in-view { opacity: 1; transform: translateY(0); }

  .btn-magnetic { transition: transform 0.18s ease; }

  .grad-text {
    background: linear-gradient(100deg, var(--accent) 10%, var(--accent2) 55%, var(--blue) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @keyframes drift {
    0%   { transform: translate(0,0) scale(1); }
    50%  { transform: translate(30px,-24px) scale(1.06); }
    100% { transform: translate(0,0) scale(1); }
  }
  @keyframes spin-slow { to { transform: rotate(360deg); } }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.25; } }
  @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
  @keyframes floatY { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @keyframes ctaPulseRing {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    70%  { box-shadow: 0 0 0 18px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero {
    position: relative;
    padding: 5.5rem 1.5rem 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    isolation: isolate;
  }

  .hero-bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .grid-fade {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--text) 4%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text) 4%, transparent) 1px, transparent 1px);
