---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { Image } from "astro:assets";
import {
  waUrl,
  WA_NUMBER,
  SITE_LOGO,
  SITE_LOGO_ACCENT,
  MULTICURRENCY_ENABLED,
  ACTIVE_CURRENCIES,
  DEFAULT_CURRENCY,
  ALLOW_USD_TOGGLE,
  CURRENCY_DEFS,
} from "../data/config";
import { CREDIT_NAME, CREDIT_URL, CREDIT_TEXT } from "../data/credits";
import whatsappIcon from "../assets/whatsapp.png";

// Solo códigos con definición conocida en CURRENCY_DEFS, sin duplicados.
const currencyOptions = [...new Set(ACTIVE_CURRENCIES)].filter((code) => CURRENCY_DEFS[code]);
const showCurrencyToggle = MULTICURRENCY_ENABLED && currencyOptions.length > 0 && (ALLOW_USD_TOGGLE || currencyOptions.length > 1);
const initialCurrency = MULTICURRENCY_ENABLED && currencyOptions.includes(DEFAULT_CURRENCY) ? DEFAULT_CURRENCY : "USD";

const currencyClientConfig = currencyOptions.map((code) => ({
  code,
  label: CURRENCY_DEFS[code].label,
  apiUrl: CURRENCY_DEFS[code].apiUrl,
}));

const waGeneral = waUrl("Hola! Vengo de su página web y me interesa activar una cuenta de streaming. ¿Me pueden dar más información?");
const waRecargas = waUrl("Hola! Vengo de su página web y quiero hacer una recarga para juegos / TikTok.");

// Categoría 1: Streaming Principal
const streamingPlans = [
  { id: "netflix", name: "Netflix", tag: "Series y Películas Top", price: "33", initial: "N", iconBg: "linear-gradient(135deg,#dc2626,#ff2d78)", badge: "Más vendido", badgeBg: "rgba(34,229,138,0.16)", badgeColor: "#22e58a", features: ["Pantalla ultra HD", "Sin anuncios molestos", "Doramas Korea"] },
  { id: "disneyplus", name: "Disney", tag: "Estrenos y Clásicos", price: "25", initial: "D", iconBg: "linear-gradient(135deg,#1d4ed8,#38bdf8)", badge: "Popular", badgeBg: "rgba(255,45,120,0.16)", badgeColor: "#ff6fa3", features: ["Estrenos y clásicos", "Alta definición fluida", "Starplus incluido"] },
  { id: "disneyespn", name: "DisneyESPN", tag: "Deportes en Vivo", price: "35", initial: "D", iconBg: "linear-gradient(135deg,#0ea5e9,#2563eb)", badge: "", badgeBg: "", badgeColor: "", features: ["Deportes y series", "Fútbol en vivo", "Champions League"] },
  { id: "primevideo", name: "PrimeVideo", tag: "Series y Películas 4K", price: "23", initial: "P", iconBg: "linear-gradient(135deg,#0ea5e9,#60a5fa)", badge: "Oferta", badgeBg: "rgba(168,85,247,0.16)", badgeColor: "#c084fc", features: ["Amazon Originals incluidos", "Excelente calidad 4K", "Los Ingals, Clasicos"] },
  { id: "hbomax", name: "HBOMax", tag: "Cine y Exclusivos HBO", price: "25", initial: "H", iconBg: "linear-gradient(135deg,#7c3aed,#a855f7)", badge: "", badgeBg: "", badgeColor: "", features: ["Contenido HBO exclusivo", "Estrenos de cine", "Terror, Casa del Dragon"] },
  { id: "flujotv", name: "FlujoTV", tag: "Televisión por Internet", price: "25", initial: "F", iconBg: "linear-gradient(135deg,#059669,#34d399)", badge: "", badgeBg: "", badgeColor: "", features: ["Canales en vivo", "Deportes y películas", "Lo que da en el Cine"] },
  { id: "spotify", name: "Spotify", tag: "Música sin Anuncios", price: "33", initial: "S", iconBg: "linear-gradient(135deg,#15803d,#4ade80)", badge: "", badgeBg: "", badgeColor: "", features: ["Música sin límites", "Audio alta calidad", "Renovable"] },
  { id: "crunchyroll", name: "Cruchyrol", tag: "Anime en HD", price: "22", initial: "C", iconBg: "linear-gradient(135deg,#15803d,#4ade80)", badge: "", badgeBg: "", badgeColor: "", features: ["Animes full", "De 1 mes o 3 meses", "Doblados Esp."] },
  { id: "otrasapp", name: "OtrasAPP", tag: "A Pedido del Cliente", price: "0", initial: "O", iconBg: "linear-gradient(135deg,#475569,#64748b)", badge: "A pedido", badgeBg: "rgba(100,116,139,0.16)", badgeColor: "#94a3b8", features: ["Vix+, Paramount,", "CapCut, Canva", "Pregunta por tu app"] },
];

// Categoría 2: Planes Especiales / Multimedia y Productos Físicos
const specialPlans = [
  { id: "tvbox", name: "TVBox", image: "/tvbox.webp", tag: "Smart TV para cualquier tele", price: "250", initial: "T", iconBg: "linear-gradient(135deg,#b91c1c,#ef4444)", badge: "Más vendido", badgeBg: "rgba(34,229,138,0.16)", badgeColor: "#22e58a", features: ["Android TV veloz", "Streaming fullHD", "Listo para usar"] },
  { id: "proyector", name: "Proyector", image: "/proyector.webp", tag: "Entretenimiento en grande", price: "350", initial: "M", iconBg: "linear-gradient(135deg,#7c3aed,#c084fc)", badge: "Popular", badgeBg: "rgba(255,45,120,0.16)", badgeColor: "#ff6fa3", features: ["Cine en casa", "Fácil de transportar", "Gran nitidez visual"] },
  { id: "arosluz", name: "ArosLED", image: "/arosled.webp", tag: "Creadores de Contenido", price: "120", initial: "A", iconBg: "linear-gradient(135deg,#d97706,#fbbf24)", badge: "Oferta", badgeBg: "rgba(168,85,247,0.16)", badgeColor: "#c084fc", features: ["Trípode fuerte incluido", "Iluminación ajustable pro", "Ideal para TikTok"] },
  { id: "repetidor", name: "Repetidor", image: "/repetidor.webp", tag: "Mayor Cobertura Wi-Fi", price: "130", initial: "R", iconBg: "linear-gradient(135deg,#0284c7,#38bdf8)", badge: "", badgeBg: "", badgeColor: "", features: ["Amplía señal Wifi", "Súper fácil configuración", "Adiós zonas ciegas"] },
  { id: "control", name: "Control", image: "/control.webp", tag: "Mando para Smart TV", price: "90", initial: "C", iconBg: "linear-gradient(135deg,#334155,#64748b)", badge: "", badgeBg: "", badgeColor: "", features: ["Compatible universal TV", "Práctico y moderno", "Configuración en segundos"] },
  { id: "powerbank", name: "PowerBank", image: "/power.webp", tag: "Reserva de Energía", price: "150", initial: "P", iconBg: "linear-gradient(135deg,#16a34a,#4ade80)", badge: "", badgeBg: "", badgeColor: "", features: ["Carga varios dias", "Alta capacidad real", "Energía todo el día"] },
  { id: "audifonos", name: "Audífonos", image: "/audifono.webp", tag: "Audio sin Cables", price: "90", initial: "A", iconBg: "linear-gradient(135deg,#4f46e5,#818cf8)", badge: "", badgeBg: "", badgeColor: "", features: ["Sonido estéreo", "Conexión inalámbrica", "Comodidad sin cables"] },
  { id: "parlantes", name: "Parlantes", image: "/parlante.webp", tag: "Sonido Alta Potencia", price: "150", initial: "S", iconBg: "linear-gradient(135deg,#0284c7,#2563eb)", badge: "", badgeBg: "", badgeColor: "", features: ["Portatiles", "ideal dormitorio", "30w, 50w, reales"] },
  { id: "otrosgadgets", name: "Gadgets", image: "/gadget.webp", tag: "Accesorios y Utilidades", price: "0", initial: "G", iconBg: "linear-gradient(135deg,#475569,#64748b)", badge: "A pedido", badgeBg: "rgba(100,116,139,0.16)", badgeColor: "#94a3b8", features: ["Mesa plegables", "Sillas plegables,", "Mesas de cacho"] },
];


const FIXED_VES_RATE_ENABLED = true;
const FIXED_VES_RATE = 40;

const faqs = [
  { question: "¿Cuánto tiempo tarda en llegar mi cuenta?", answer: "Menos de 5 minutos. En cuanto confirmamos tu pago, te enviamos el correo y la contraseña directa." },
  { question: "¿Qué pasa si mi cuenta falla?", answer: "La reponemos sin costo y sin preguntas durante todo el período contratado." },
  { question: "¿Puedo compartir la cuenta?", answer: "Depende del plan: ofrecemos cuentas individuales y de perfil compartido, según lo que necesites." },
  { question: "¿Qué métodos de pago aceptan?", answer: "Transferencias locales, Binance Pay, USDT y más. Te decimos cómo pagar en menos de un minuto." },
  { question: "¿Es seguro comprar aquí?", answer: "Sí. Entregamos primero la información completa y respaldamos cada venta con garantía de reposición." },
];

const rotatorLines = [
  "Un mensaje y en minutos tienes tu cuenta activa.",
  "Las cuentas vuelan. Asegura la tuya ahora mismo.",
  "Más de 2.430 clientes ya disfrutan sus cuentas.",
  "Escríbenos y lo activamos en el momento.",
];
---

<Layout>
  <Navbar />

  <div class="page">

    <!-- Logos strip -->
    <section class="strip reveal">
      <div class="strip-track">
        <a href="#catalogo">NETFLIX</a>
        <a href="#catalogo">HBO MAX</a>
        <a href="#catalogo">DISNEY+</a>
        <a href="#catalogo">PRIME VIDEO</a>
        <a href="#catalogo">PARAMOUNT+</a>
        <a href="#catalogo">VIX</a>
        <a href="#cta-final">TV BOX</a>
        <a href="#cta-final">PARLANTES</a>
        <a href="#catalogo">NETFLIX</a>
        <a href="#catalogo">HBO MAX</a>
        <a href="#catalogo">DISNEY+</a>
        <a href="#catalogo">PRIME VIDEO</a>
        <a href="#catalogo">PARAMOUNT+</a>
        <a href="#catalogo">VIX</a>
        <a href="#cta-final">TV BOX</a>
        <a href="#cta-final">PARLANTES</a>
      </div>
    </section>

    <!-- Catálogo (Solo Categoría 1: Streaming) -->
    <section class="section" id="catalogo">
      <div class="section-head reveal">
        <span class="eyebrow">Catálogo</span>
        <h2 class="display">Elige tu <span class="grad-text">plataforma</span></h2>
        <p>Acceso inmediato, verificado y con garantía. Sin contratos, sin complicaciones.</p>

        {showCurrencyToggle && (
          <div class="currency-toggle" id="currencyToggle" role="group" aria-label="Elegir moneda">
            {[...currencyOptions.filter((c) => c === initialCurrency), ...currencyOptions.filter((c) => c !== initialCurrency)].map((code) => (
              <button
                type="button"
                class={`currency-toggle-btn${code === initialCurrency ? " is-active" : ""}`}
                data-currency-btn={code}
                aria-pressed={code === initialCurrency ? "true" : "false"}
              >
                {CURRENCY_DEFS[code].label}
              </button>
            ))}
            {ALLOW_USD_TOGGLE && (
              <button
                type="button"
                class={`currency-toggle-btn${initialCurrency === "USD" ? " is-active" : ""}`}
                data-currency-btn="USD"
                aria-pressed={initialCurrency === "USD" ? "true" : "false"}
              >
                USD
              </button>
            )}
          </div>
        )}
      </div>

      <!-- GRUPO 1: Streaming Principal -->
      <div class="category-group">
        <h3 class="display category-subheading">🎬 Plataformas de Streaming</h3>
        <div class="cat-grid">
          {streamingPlans.map((plan, i) => (
            <div class="cat-card reveal" style={`animation-delay:${i * 70}ms`} data-plan-id={plan.id} data-plan-name={plan.name} data-plan-price={plan.price}>
              
              <!-- Botón flotante de Me Gusta -->
              <button type="button" class="cat-like-badge" onclick="darLikeLocal(this)">
                <span>❤️</span> <span class="like-count">0</span>
              </button>

              {plan.badge && (
                <span class="cat-badge" style={`background:${plan.badgeBg};color:${plan.badgeColor}`}>{plan.badge}</span>
              )}
              <div class="cat-card-top">
                <div class="cat-icon" style={`background:${plan.iconBg}`}>{plan.initial}</div>
                <div>
                  <strong class="cat-name">{plan.name}</strong>
                  <span class="cat-tag">{plan.tag}</span>
                </div>
                {plan.image && <img src={plan.image} alt={plan.name} style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px; margin-left: auto;" />}
              </div>
              <ul class="cat-features">
                {plan.features.map((f) => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    {f}
                  </li>
                ))}
              </ul>
              <div class="cat-foot">
                <div class="cat-price"><span class="cat-price-num" data-price-usd={plan.price}>${plan.price}</span><span class="cat-price-period">/ mes</span></div>
                <button type="button" class="cat-btn cat-btn-add" data-add-to-cart>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  <span class="cat-btn-label">Agregar</span>
                </button>
                <div class="cat-stepper" data-stepper hidden>
                  <button type="button" class="cat-stepper-btn" data-qty-decrease aria-label={`Quitar una unidad de ${plan.name}`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                  <span class="cat-stepper-qty" data-qty>1</span>
                  <button type="button" class="cat-stepper-btn" data-qty-increase aria-label={`Agregar una unidad de ${plan.name}`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
   
    <!-- Hero (Propaganda de Recargas de Juegos y TikTok al medio) -->
    <section class="hero" id="recargas">
      <div class="hero-bg" aria-hidden="true">
        <div class="grid-fade"></div>
        <div class="orb orb-a"></div>
        <div class="orb orb-b"></div>
        <div class="orb orb-c"></div>
      </div>

<div class="hero-badge reveal" style="animation-delay:0s">
  <span class="live-dot"></span>
  <span>Visitas totales: <strong class="site-visits-counter">...</strong></span>
</div>



      <div class="hero-inner">
        <div class="hero-badge reveal" style="animation-delay:0s">
          <span class="live-dot"></span>
          Recargas disponibles al instante
        </div>

        <h1 class="hero-title display reveal" style="animation-delay:.08s">
          Recargas para <span class="grad-text">Juegos y TikTok</span>
        </h1>

        <p class="hero-sub reveal" style="animation-delay:.16s">
          Recarga diamantes en <strong>Free Fire</strong>, monedas en <strong>Roblox</strong>, saldo para <strong>TikTok</strong> y muchos juegos más de forma rápida y segura.
        </p>

        <div class="hero-cta-row reveal" style="animation-delay:.24s">
          <a href={waRecargas} class="btn-primary btn-magnetic" target="_blank" rel="noopener">
            <span class="btn-primary-glow"></span>
            <span class="btn-primary-label">
              <Image src={whatsappIcon} alt="WhatsApp" class="btn-icon" width={20} height={20} loading="eager" fetchpriority="high" />
              Háblame para recargar directo
            </span>
          </a>
          <div class="hero-cta-hint">
            <span class="hero-cta-hint-arrow">↳</span> atención inmediata por WhatsApp
          </div>
        </div>

        <div class="hero-platforms reveal" style="animation-delay:.4s">
          <span>Free Fire</span><span>Roblox</span><span>TikTok</span><span>Otros juegos</span>
        </div>
      </div>
    </section>

    <!-- GRUPO 2: Servicios Multimedia y Otros -->
    <section class="section" id="multimedia-otros">
      <div class="category-group">
        <div class="section-head reveal">
          <span class="eyebrow">Productos y más</span>
          <h2 class="display">⭐ Servicios Multimedia <span class="grad-text">y Otros</span></h2>
          <p>Parlantes bluetooth, audífonos, cargadores, TV Box y productos físicos disponibles.</p>
        </div>
        <div class="cat-grid">
          {specialPlans.map((plan, i) => (
            <div class="cat-card reveal" style={`animation-delay:${i * 70}ms`} data-plan-id={plan.id} data-plan-name={plan.name} data-plan-price={plan.price}>
              
              <!-- Botón flotante de Me Gusta -->
              <button type="button" class="cat-like-badge" onclick="darLikeLocal(this)">
                <span>❤️</span> <span class="like-count">0</span>
              </button>

              {plan.badge && (
                <span class="cat-badge" style={`background:${plan.badgeBg};color:${plan.badgeColor}`}>{plan.badge}</span>
              )}

              <div class="cat-card-top">
                <div class="cat-icon" style={`background:${plan.iconBg}`}>{plan.initial}</div>
                <div>
                  <strong class="cat-name">{plan.name}</strong>
                  <span class="cat-tag">{plan.tag}</span>
                </div>
              </div>

              <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px;">
                <ul class="cat-features" style="flex: 1; margin: 0; padding: 0; list-style: none;">
                  {plan.features.map((f) => (
                    <li style="display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                      {f}
                    </li>
                  ))}
                </ul>

               {plan.image && (
                  <div style="width: 100px; flex-shrink: 0; text-align: center;">
                    <img src={plan.image} alt={plan.name} style="width: 100%; max-height: 100px; object-fit: contain; border-radius: 6px; display: block;" />
                  </div>
                )}
              </div>

              <div class="cat-foot">
                <div class="cat-price"><span class="cat-price-num" data-price-usd={plan.price}>${plan.price}</span><span class="cat-price-period"> </span></div>
                <button type="button" class="cat-btn cat-btn-add" data-add-to-cart>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  <span class="cat-btn-label">Agregar</span>
                </button>
                <div class="cat-stepper" data-stepper hidden>
                  <button type="button" class="cat-stepper-btn" data-qty-decrease aria-label={`Quitar una unidad de ${plan.name}`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                  <span class="cat-stepper-qty" data-qty>1</span>
                  <button type="button" class="cat-stepper-btn" data-qty-increase aria-label={`Agregar una unidad de ${plan.name}`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Garantías -->
    <section class="section" id="garantias">
      <div class="section-head reveal">
        <span class="eyebrow">Por qué confiar</span>
        <h2 class="display">Cero riesgo, <span class="grad-text">todo beneficio</span></h2>
      </div>

      <div class="feat-grid">
        <div class="feat-card reveal">
          <div class="feat-icon-wrap"><span class="feat-icon-glow feat-icon-glow--pink"></span>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <strong>Activación en minutos</strong>
          <p>Recibe tus datos de acceso en menos de 5 minutos. Sin esperas, sin trámites.</p>
        </div>
        <div class="feat-card reveal">
          <div class="feat-icon-wrap"><span class="feat-icon-glow feat-icon-glow--violet"></span>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <strong>Garantía incluida</strong>
          <p>Cuentas verificadas. Si algo falla, la reponemos sin costo.</p>
        </div>
        <div class="feat-card reveal">
          <div class="feat-icon-wrap"><span class="feat-icon-glow feat-icon-glow--green"></span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
          </div>
          <strong>Soporte 24/7</strong>
          <p>Un agente real te responde por WhatsApp a cualquier hora.</p>
        </div>
        <div class="feat-card reveal">
          <div class="feat-icon-wrap"><span class="feat-icon-glow feat-icon-glow--blue"></span>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <strong>El mejor precio</strong>
          <p>Precios transparentes. Lo que ves es lo que pagas.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section" id="faq">
      <div class="section-head reveal">
        <span class="eyebrow">Dudas frecuentes</span>
        <h2 class="display">Preguntas <span class="grad-text">frecuentes</span></h2>
      </div>

      <div class="faq-list reveal">
        {faqs.map((faq) => (
          <div class="faq-item">
            <button class="faq-q" aria-expanded="false">
              <span>{faq.question}</span>
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="faq-a"><p>{faq.answer}</p></div>
